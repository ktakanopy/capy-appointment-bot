    {
      "id": "capy-0072",
      "type": "text",
      "x": 84,
      "y": 2109.7999999999997,
      "width": 652,
      "height": 371.8,
      "angle": 0,
      "strokeColor": "#253047",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
