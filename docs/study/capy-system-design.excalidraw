    {
      "id": "capy-0413",
      "type": "text",
      "x": 1254,
      "y": 13798.000000000002,
      "width": 1062,
      "height": 228.8,
      "angle": 0,
      "strokeColor": "#253047",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "capy-0411-group"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 733901,
      "version": 1,
      "versionNonce": 128443,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794484800000,
      "created": 1794484800000,
      "link": null,
      "locked": false,
      "text": "Why can a webhook return 200 before the customer gets a reply?\nWhy do updates and commands need different idempotency keys?\nWhy is 100k MAU insufficient to size workers?\nWhy is Redis not the source of booking truth?\nWhy can one delayed reply block unrelated users today?\nWhy do separate FKs not guarantee the same tenant?\nWhich table would you remove first, and what would you check?\nWhat happens if a worker dies just after the booking commits?",
      "originalText": "Why can a webhook return 200 before the customer gets a reply?\nWhy do updates and commands need different idempotency keys?\nWhy is 100k MAU insufficient to size workers?\nWhy is Redis not the source of booking truth?\nWhy can one delayed reply block unrelated users today?\nWhy do separate FKs not guarantee the same tenant?\nWhich table would you remove first, and what would you check?\nWhat happens if a worker dies just after the booking commits?",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 22
    },
