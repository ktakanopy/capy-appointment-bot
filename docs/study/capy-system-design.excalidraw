      "roundness": null,
      "seed": 117282,
      "version": 1,
      "versionNonce": 20526,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794484800000,
      "created": 1794484800000,
      "link": null,
      "locked": false,
      "text": "A cafe receiving 2 customers/minute, each staying 10 minutes, has about 20 customers inside on average. CAPY is the same queueing idea. Averages do not describe\nbursts or p95 latency. Keep warm spare capacity; autoscaling reacts after demand changes.",
      "originalText": "A cafe receiving 2 customers/minute, each staying 10 minutes, has about 20 customers inside on average. CAPY is the same queueing idea. Averages do not describe\nbursts or p95 latency. Keep warm spare capacity; autoscaling reacts after demand changes.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 22
    },
