      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "capy-0141-group"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 250557,
      "version": 1,
      "versionNonce": 43851,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794484800000,
      "created": 1794484800000,
      "link": null,
      "locked": false
    },
    {
      "id": "capy-0142",
