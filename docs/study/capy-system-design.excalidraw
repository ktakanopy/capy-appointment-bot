      "text": "QUALITY / define what success means",
      "originalText": "QUALITY / define what success means",
      "fontSize": 26,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 26
    },
    {
      "id": "capy-0012",
      "type": "text",
      "x": 1254,
      "y": 524.8,
      "width": 1062,
      "height": 314.6,
      "angle": 0,
      "strokeColor": "#253047",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "capy-0010-group"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 21324,
      "version": 1,
      "versionNonce": 3732,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794484800000,
      "created": 1794484800000,
      "link": null,
      "locked": false,
      "text": "100k monthly ACTIVE users across businesses. This is not 100k concurrent\nrequests.\n\np95 text reply <= 5 seconds: webhook receipt to Telegram accepting the reply.\nVoice must be benchmarked by recording duration.\n\n99.9% daily availability: time-based equivalent is 86.4 seconds unavailable per\nday. A monthly window is different.\n\nTrack failed scheduling journeys, not just HTTP 200 acknowledgments. An error\nreply is not a successful booking.",
      "originalText": "100k monthly ACTIVE users across businesses. This is not 100k concurrent\nrequests.\n\np95 text reply <= 5 seconds: webhook receipt to Telegram accepting the reply.\nVoice must be benchmarked by recording duration.\n\n99.9% daily availability: time-based equivalent is 86.4 seconds unavailable per\nday. A monthly window is different.\n\nTrack failed scheduling journeys, not just HTTP 200 acknowledgments. An error\nreply is not a successful booking.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 22
    },
