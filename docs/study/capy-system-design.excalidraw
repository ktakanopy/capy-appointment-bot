      "version": 1,
      "versionNonce": 51626,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794484800000,
      "created": 1794484800000,
      "link": null,
      "locked": false,
      "text": "One professional can offer several services. One service can be offered by\nseveral professionals. professional_services models this many-to-many\nrelationship without copying names or prices.\n\nProfessionals also have 1:N weekly_availability_rules and 1:N blocked_periods:\nrecurring opening hours and dated exceptions are different concepts.",
      "originalText": "One professional can offer several services. One service can be offered by\nseveral professionals. professional_services models this many-to-many\nrelationship without copying names or prices.\n\nProfessionals also have 1:N weekly_availability_rules and 1:N blocked_periods:\nrecurring opening hours and dated exceptions are different concepts.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 22
    },
