    {
      "id": "capy-0404",
      "type": "text",
      "x": 84,
      "y": 13378.000000000002,
      "width": 2232,
      "height": 85.8,
      "angle": 0,
      "strokeColor": "#253047",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "capy-0402-group"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 717908,
      "version": 1,
      "versionNonce": 125644,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794484800000,
      "created": 1794484800000,
      "link": null,
      "locked": false,
      "text": "Start with the existing PostgreSQL ledger as the durable queue. No Kafka, database sharding, separate booking microservice, vector database or multi-region writes\nsolely because there are 100k monthly users. Add a broker when queue load, fan-out or operational needs justify it. Gemma and Laya are required here; optimize and\nbenchmark their boundary rather than silently removing one.",
      "originalText": "Start with the existing PostgreSQL ledger as the durable queue. No Kafka, database sharding, separate booking microservice, vector database or multi-region writes\nsolely because there are 100k monthly users. Add a broker when queue load, fan-out or operational needs justify it. Gemma and Laya are required here; optimize and\nbenchmark their boundary rather than silently removing one.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 22
    },
