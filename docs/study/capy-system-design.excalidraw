    {
      "id": "capy-0009",
      "type": "text",
      "x": 84,
      "y": 524.8,
      "width": 1062,
      "height": 314.6,
      "angle": 0,
      "strokeColor": "#253047",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "capy-0007-group"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 15993,
      "version": 1,
      "versionNonce": 2799,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794484800000,
      "created": 1794484800000,
      "link": null,
      "locked": false,
      "text": "Find available slots; book; look up upcoming appointments; confirm, cancel and\nreschedule.\n\nAsk about services and prices. Receive text and voice through Telegram. Reply\nin text and voice.\n\nMultiple businesses: each customer, catalog, schedule and booking must stay in\nthe correct tenant.\n\nCurrent gaps: voice replies are not implemented; FAQ answers use catalog fields\nand fixed templates, not a general knowledge base.",
      "originalText": "Find available slots; book; look up upcoming appointments; confirm, cancel and\nreschedule.\n\nAsk about services and prices. Receive text and voice through Telegram. Reply\nin text and voice.\n\nMultiple businesses: each customer, catalog, schedule and booking must stay in\nthe correct tenant.\n\nCurrent gaps: voice replies are not implemented; FAQ answers use catalog fields\nand fixed templates, not a general knowledge base.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 22
    },
