    {
      "id": "capy-0166",
      "type": "text",
      "x": 84,
      "y": 5420.200000000001,
      "width": 1062,
      "height": 171.6,
      "angle": 0,
      "strokeColor": "#253047",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
