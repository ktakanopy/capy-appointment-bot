      "opacity": 100,
      "groupIds": [
        "capy-0351-group"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 627281,
      "version": 1,
      "versionNonce": 109783,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794484800000,
      "created": 1794484800000,
      "link": null,
      "locked": false,
      "text": "Business A owns booking X. Customer C belongs to business B.\n\nIndependent FKs accept A and C because each exists. They do not check that C\nbelongs to A.\n\nApplication create/ownership paths do check business/customer identity. The gap\nmatters for bugs, imports and future writers.\n\nProposed: UNIQUE(id, business_id) on parents and FOREIGN KEY(customer_id,\nbusiness_id) referencing customers(id, business_id). Extend the pattern to\nother tenant links.",
      "originalText": "Business A owns booking X. Customer C belongs to business B.\n\nIndependent FKs accept A and C because each exists. They do not check that C\nbelongs to A.\n\nApplication create/ownership paths do check business/customer identity. The gap\nmatters for bugs, imports and future writers.\n\nProposed: UNIQUE(id, business_id) on parents and FOREIGN KEY(customer_id,\nbusiness_id) referencing customers(id, business_id). Extend the pattern to\nother tenant links.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 22
    },
