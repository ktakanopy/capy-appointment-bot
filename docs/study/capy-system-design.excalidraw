      "link": null,
      "locked": false,
      "text": "WHY THE SAME USER MUST BE SERIALIZED",
      "originalText": "WHY THE SAME USER MUST BE SERIALIZED",
      "fontSize": 26,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 26
    },
    {
      "id": "capy-0143",
      "type": "text",
      "x": 1254,
      "y": 4259.8,
      "width": 1062,
      "height": 171.6,
      "angle": 0,
      "strokeColor": "#253047",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "capy-0141-group"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 254111,
      "version": 1,
      "versionNonce": 44473,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794484800000,
      "created": 1794484800000,
      "link": null,
      "locked": false,
      "text": "Message A: show tomorrow's slots. Message B: choose option 1. If B runs before\nA finishes, it may read an old offer.\n\nSerialize by business + bot + user. Preserve order for one conversation, not\nglobally for the entire bot. Handle late arrivals explicitly; per-user locking\nalone does not reorder webhooks.",
      "originalText": "Message A: show tomorrow's slots. Message B: choose option 1. If B runs before\nA finishes, it may read an old offer.\n\nSerialize by business + bot + user. Preserve order for one conversation, not\nglobally for the entire bot. Handle late arrivals explicitly; per-user locking\nalone does not reorder webhooks.",
      "fontSize": 22,
      "fontFamily": 2,
