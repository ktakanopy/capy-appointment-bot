      "seed": 127944,
      "version": 1,
      "versionNonce": 22392,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794484800000,
      "created": 1794484800000,
      "link": null,
      "locked": false,
      "text": "Poll Telegram -> persist update -> process graph\n-> save reply -> send reply.\n\nOne advisory lock per bot. Turns run\nsequentially. Audio, model calls and delivery\nshare the loop.\n\napp/main.py serves health only. More API\nreplicas do not increase conversation\nthroughput.\n\nGood MVP property: simple ownership and\nconservative crash behavior.",
      "originalText": "Poll Telegram -> persist update -> process graph\n-> save reply -> send reply.\n\nOne advisory lock per bot. Turns run\nsequentially. Audio, model calls and delivery\nshare the loop.\n\napp/main.py serves health only. More API\nreplicas do not increase conversation\nthroughput.\n\nGood MVP property: simple ownership and\nconservative crash behavior.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 22
    },
