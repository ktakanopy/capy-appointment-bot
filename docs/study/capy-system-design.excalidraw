      "version": 1,
      "versionNonce": 23325,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794484800000,
      "created": 1794484800000,
      "link": null,
      "locked": false,
      "text": "A webhook should acknowledge after durable\nstorage, not wait for inference. Workers can\nthen process many independent conversations.\n\nDo not remove the single-worker lock until\nconversation serialization, safe claims and\nrecovery exist.",
