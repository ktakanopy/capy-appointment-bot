    {
      "id": "capy-0140",
      "type": "text",
      "x": 84,
      "y": 4259.8,
      "width": 1062,
      "height": 171.6,
      "angle": 0,
      "strokeColor": "#253047",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "capy-0138-group"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 248780,
      "version": 1,
      "versionNonce": 43540,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794484800000,
      "created": 1794484800000,
      "link": null,
      "locked": false,
      "text": "Current: recover_interrupted() sends a check-your-appointments message instead\nof replaying the graph. Safe, but less convenient.\n\nProposed: save an immutable command; commit its outcome with the booking;\nreconstruct the reply from that outcome. Never reinterpret a possibly committed\nturn as a different action.",
      "originalText": "Current: recover_interrupted() sends a check-your-appointments message instead\nof replaying the graph. Safe, but less convenient.\n\nProposed: save an immutable command; commit its outcome with the booking;\nreconstruct the reply from that outcome. Never reinterpret a possibly committed\nturn as a different action.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 22
    },
    {
