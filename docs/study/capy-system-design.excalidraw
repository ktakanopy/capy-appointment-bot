      "updated": 1794484800000,
      "created": 1794484800000,
      "link": null,
      "locked": false,
      "text": "KEEP / overlap + idempotency",
      "originalText": "KEEP / overlap + idempotency",
      "fontSize": 26,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 26
    },
    {
      "id": "capy-0356",
      "type": "text",
      "x": 1254,
      "y": 12173.7,
      "width": 1062,
      "height": 257.40000000000003,
      "angle": 0,
      "strokeColor": "#253047",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "capy-0354-group"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 632612,
      "version": 1,
      "versionNonce": 110716,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794484800000,
      "created": 1794484800000,
      "link": null,
      "locked": false,
      "text": "Two users can both see 10:00 as free. Search is only a snapshot. Revalidate\nwhen booking and keep the exclusion constraint as the final race-safe guard.\n\nThe occupied interval includes preparation/cleanup buffers. Adjacent half-open\nranges [start, end) do not overlap.\n\nA retry with the same operation key should reuse the committed result. Today\nreplay reads the current booking row, so it is not an immutable copy of the\noriginal response.",
      "originalText": "Two users can both see 10:00 as free. Search is only a snapshot. Revalidate\nwhen booking and keep the exclusion constraint as the final race-safe guard.\n\nThe occupied interval includes preparation/cleanup buffers. Adjacent half-open\nranges [start, end) do not overlap.\n\nA retry with the same operation key should reuse the committed result. Today\nreplay reads the current booking row, so it is not an immutable copy of the\noriginal response.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 22
    },
