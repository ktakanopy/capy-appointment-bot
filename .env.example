# Normal application operation requires externally hosted Gemma and Laya.
APP_POSTGRES_USER=scheduling
APP_POSTGRES_PASSWORD=scheduling
APP_POSTGRES_DB=scheduling
DEMO_BUSINESS_ID=demo-studio
# Host-process defaults. Compose uses host.docker.internal unless overridden.
# GEMMA_BASE_URL=http://your-model-host:8081
# LAYA_BASE_URL=http://your-model-host:8082
CHAT_REDIS_URL=redis://localhost:6380/0
SESSION_TTL_MINUTES=60
TELEGRAM_BOT_TOKEN=
TELEGRAM_POLL_SECONDS=20
TELEGRAM_AUDIO_MAX_BYTES=20000000
TELEGRAM_AUDIO_MAX_DECODED_BYTES=536870912
TELEGRAM_AUDIO_DECODE_TIMEOUT_SECONDS=120
TELEGRAM_AUDIO_CHUNK_TIMEOUT_SECONDS=60
TELEGRAM_AUDIO_PROCESSING_TIMEOUT_SECONDS=900
# Add docker-compose.observability.yml to self-host Langfuse.
TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse-web:3000
