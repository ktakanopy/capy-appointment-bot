# The local model service serves Gemma and Laya on port 8081.
APP_POSTGRES_USER=scheduling
APP_POSTGRES_PASSWORD=scheduling
APP_POSTGRES_DB=scheduling
DEMO_BUSINESS_ID=demo-studio
# Host processes use localhost. Compose uses host.docker.internal.
# Set explicit URLs to use separate model services.
# GEMMA_BASE_URL=http://localhost:8081
# LAYA_BASE_URL=http://localhost:8081
CHAT_REDIS_URL=redis://localhost:6380/0
SESSION_TTL_MINUTES=60
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_AUDIO_MAX_BYTES=20000000
TELEGRAM_AUDIO_MAX_DECODED_BYTES=536870912
TELEGRAM_AUDIO_DECODE_TIMEOUT_SECONDS=120
TELEGRAM_AUDIO_CHUNK_TIMEOUT_SECONDS=60
TELEGRAM_AUDIO_PROCESSING_TIMEOUT_SECONDS=900
# Add docker-compose.observability.yml to self-host Langfuse.
TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse-web:3000
CAPY_LOG_LEVEL=INFO
