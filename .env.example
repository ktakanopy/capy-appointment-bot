# Docker Compose defaults; use a new value outside the local synthetic demo.
APP_POSTGRES_USER=scheduling
APP_POSTGRES_PASSWORD=scheduling
APP_POSTGRES_DB=scheduling
BOOKING_TOKEN_SECRET=replace-with-at-least-32-random-bytes
DEMO_BUSINESS_ID=demo-studio

# gemma is the default understanding model for text, SMS, and audio.
# laya is the default router. Both fall back to deterministic parsing if the local server is down.
UNDERSTANDING_PROVIDER=gemma
DECISION_PROVIDER=laya
# Host process defaults to localhost in code. Do not set localhost here:
# docker compose --env-file would override the container URLs.
# LLM_PROVIDER=openai plus OPENAI_API_KEY still selects OpenAI.
LLM_PROVIDER=deterministic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
CHAT_REDIS_URL=redis://localhost:6380/0

# Optional Langfuse profile. Keep tracing disabled unless the observability profile is running.
TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse-web:3000

# Optional. When unset, owner routes stay open for the local demo.
OWNER_API_TOKEN=

# Optional WhatsApp Cloud API adapter. Leave unset to keep the webhook disabled.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Optional SMS webhook. Leave unset to keep the endpoint disabled.
SMS_WEBHOOK_SECRET=
